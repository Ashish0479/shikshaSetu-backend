PROJECT_NAME="Teacher Data Quality & Standardization System"
ENVIRONMENT="development"
DEBUG=True

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=shikshasetu_quality_db
MONGODB_TIMEOUT_MS=3000

# File Upload Thresholds
MAX_FILE_SIZE_BYTES=15728640

# Layer 6 Gemini provider (server-side only; never expose through VITE_*)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30
L6_MAX_CONTEXT_CHARS=24000
L6_MAX_OUTPUT_CHARS=6000
